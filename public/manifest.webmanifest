{
  "name": "PhotoSize",
  "short_name": "PhotoSize",
  "description": "Free image tools that run on your device: combine images, resize in KB for forms, scan to PDF, passport photos, signatures, Urdu and Arabic cards, and more.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3f4f2",
  "theme_color": "#2f6b4f",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf", ".pdf"] }]
    }
  }
}
